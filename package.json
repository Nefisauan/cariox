{
  "name": "cariox-academy",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-test-module-mocks --import tsx --test tests/*.test.ts tests/*.test.tsx",
    "audit:production": "node scripts/audit-production.mjs",
    "cf:build": "WRANGLER_SEND_METRICS=false NEXT_TELEMETRY_DISABLED=1 CLOUDFLARE_BUILD=1 opennextjs-cloudflare build",
    "cf:check": "WRANGLER_SEND_METRICS=false wrangler deploy --dry-run --outdir .open-next/dry-run",
    "cf:types": "WRANGLER_SEND_METRICS=false wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "studio:build": "node scripts/check-sanity-env.mjs && DO_NOT_TRACK=1 sanity build studio-dist",
    "studio:typegen": "node scripts/check-sanity-env.mjs && DO_NOT_TRACK=1 sanity schema extract --path sanity/schema.json && DO_NOT_TRACK=1 sanity typegen generate",
    "audit:design": "node scripts/check-design-parity.mjs"
  },
  "dependencies": {
    "@sanity/client": "^8.15.0",
    "groq": "^6.22.0",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.16",
    "@sanity/schema": "^6.22.0",
    "@testing-library/react": "^16.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "axe-core": "^4.14.0",
    "groq-js": "^2.0.1",
    "jsdom": "^29.1.1",
    "sanity": "^6.22.0",
    "styled-components": "^6.6.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "wrangler": "^4.158.0"
  },
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "overrides": {
    "glob@>=9 <15": "14.0.4",
    "minimatch@>=7 <12": "11.0.5",
    "js-yaml@>=3 <4": "3.15.2",
    "smol-toml@>=1 <2": "1.9.1",
    "undici@>=7 <8": "7.30.2"
  }
}
