# Copy to an ignored .env.local after the owner supplies real values.
# Every identifier/token is intentionally blank. Never commit real credentials.

# Confirmed public HTTPS origin. Leave blank while the domain is unconfirmed.
NEXT_PUBLIC_SITE_URL=

# Sanity public project settings. BOTH are required to attempt content loading.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
# Optional read-only server token, needed for a private dataset. NEVER public.
SANITY_API_READ_TOKEN=
# Standalone Studio CLI settings (use the same owner-approved project/dataset).
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=

# Marketing is disabled unless BOTH a real ID and explicit enable flag are set.
NEXT_PUBLIC_META_PIXEL_ENABLED=false
NEXT_PUBLIC_META_PIXEL_ID=
# CAPI is an optional server-only foundation, not connected to demo flows.
META_CAPI_ENABLED=false
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
# Owner must choose a currently supported Graph API version in Meta docs.
META_GRAPH_API_VERSION=
# Use only during authorized testing; clear before a future live release.
META_TEST_EVENT_CODE=

# Wrangler deployment credentials: only after owner access is granted.
# Prefer wrangler login or a narrowly scoped token supplied as a secret.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# The cf:build script sets CLOUDFLARE_BUILD=1 itself.
# No live scheduling, mail, or AI adapter is selected in registry.server.ts.
# Adding keys alone will NOT activate a service. Choose providers with the owner.

# Website Worker runtime only: keep off until the authenticated Worker, D1 and Resend are tested.
TRIAL_LEADS_ENABLED=false
TRIAL_WORKER_URL=
TRIAL_WORKER_SECRET=

# Set these on the trial Worker only (never browser variables).
# Its D1 database is configured as a LEADS_DB binding, not a public connection string.
RESEND_API_KEY=
TRIAL_FROM_EMAIL=
TRIAL_NOTIFY_EMAILS=

# Browser measurement. The switch and valid IDs are required; opt-in is still mandatory.
NEXT_PUBLIC_GOOGLE_TAG_ENABLED=false
# A valid container selects GTM and suppresses direct Meta and Google tags.
NEXT_PUBLIC_GTM_CONTAINER_ID=
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_TRIAL_LABEL=
