{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cariox-trial",
  "main": "workers/trial/index.ts",
  "compatibility_date": "2026-11-06",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "logs": { "enabled": true, "invocation_logs": false } },
  "d1_databases": [
    { "binding": "LEADS_DB", "database_name": "cariox-trials", "database_id": "56e10fd8-438d-4c67-8a95-2ac6a858669b", "migrations_dir": "workers/trial/migrations" }
  ],
  "triggers": { "crons": ["*/10 * * * *"] }
}
